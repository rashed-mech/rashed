# Local development: copy to .env.local. Production: set private host variables.
# Administrator Authentication Credentials (loaded by load-env.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT Signing Secret
JWT_SECRET=your_jwt_secret_key_here

# Shared MongoDB storage. Set the same values in Netlify's private variables.
# Never prefix a MongoDB URI, password or JWT secret with VITE_.
MONGODB_URI=
MONGODB_DB=rashed_portfolio
# Example URI shape (replace placeholders; URL-encode username/password):
# mongodb+srv://portfolio_user:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database & External APIs
# DATABASE_URL / DATABASE_URL_POOLED are currently not used by this application.
GEMINI_API_KEY=

# Optional public URL printed in generated CV links (Build scope on Netlify).
# VITE_SITE_URL=https://your-portfolio.netlify.app

PORT=4000
