# Administrator Authentication Credentials (loaded by load-env.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT Signing Secret
JWT_SECRET=your_jwt_secret_key_here

# Server-side Firestore writes. Set this in Netlify/Vercel as a private variable.
# Paste the complete service-account JSON on one line; never prefix it with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to a service-account file path.

# Database & External APIs
GEMINI_API_KEY=
