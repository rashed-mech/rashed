{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/server/db.test.ts src/server/adminEnvironment.test.ts src/server/mongoStore.test.ts src/utils/activeSection.test.ts",
    "db:migrate": "tsx scripts/migrate-mongodb.ts",
    "db:check": "tsx scripts/check-mongodb.ts",
    "build:netlify": "vite build && node scripts/build-netlify.mjs",
    "build:vercel": "vite build && esbuild api-src/handler.ts --bundle --platform=node --format=cjs --target=node20 --packages=external --outfile=api/index.js",
    "media:sync": "node scripts/sync-drive-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "motion": "^12.23.24",
    "pdfmake": "^0.3.11",
    "react": "~19.0.0",
    "react-dom": "~19.0.0",
    "serverless-http": "^3.2.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.14.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
